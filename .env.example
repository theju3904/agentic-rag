# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# --- Ports: single source of truth, read by docker-compose.yml, the Dockerfile and
# --- src/agentic_rag/config.py (via os.getenv). Nothing else hardcodes a port.
# Host-side ports (what you connect to from your machine):
POSTGRES_PORT=5433
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344
ADMINER_PORT=8081
API_PORT=8000
# Container-side ports. The postgres/qdrant/adminer images listen on these fixed ports, so
# only change them if you also reconfigure the image. API_CONTAINER_PORT is read by the
# Dockerfile (uvicorn --port) and is safe to change.
POSTGRES_CONTAINER_PORT=5432
QDRANT_HTTP_CONTAINER_PORT=6333
QDRANT_GRPC_CONTAINER_PORT=6334
ADMINER_CONTAINER_PORT=8080
API_CONTAINER_PORT=8000
# GPU server: host in GPU_URL, Gemma/vLLM endpoint port in GEMMA_PORT.
GPU_URL=10.2.1.40
GEMMA_PORT=8085

# --- Postgres (document/chunk store of record, Docker service "postgres") ---
POSTGRES_HOST=localhost
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=change-me

# --- Qdrant (dense vector ANN index, Docker service "qdrant") ---
QDRANT_URL=http://localhost:${QDRANT_HTTP_PORT}
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agentic_rag_chunks

# --- Which VectorIndex implementation to use: "qdrant" | "pgvector" ---
VECTOR_BACKEND=qdrant

# --- LLM backend: "null" (rule-based, zero-dependency) | "local" (HF transformers, CPU) | "openai" ---
LLM_BACKEND=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_GENERATION_MODEL=google/flan-t5-base

# --- Embedding / reranker models (small, CPU-friendly defaults) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Reproducibility ---
RANDOM_SEED=42

# --- API ---
API_HOST=0.0.0.0
LOG_LEVEL=INFO
