# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Environment / secrets ---
.env
*.env.local

# --- Data & model artifacts (regenerated by scripts, never hand-edited) ---
# Leading slashes anchor these to the repo root only -- a bare "data/" also
# matches src/agentic_rag/data/ (gitignore matches un-anchored patterns at
# any depth), which silently excluded that entire source package from every
# commit until this was caught.
/data/
/artifacts/
!/artifacts/.gitkeep
*.faiss
*.bin

# --- Docker volumes mounted locally ---
docker/postgres/data/

# --- Reports ---
# The curated figures ARE committed (embedded in README + report/RESULTS_*.md), so they
# are intentionally NOT ignored. Raw per-run experiment dumps below are scratch; the
# curated numbers live in report/RESULTS_TECHNICAL.md.
/report/results_bge_m3.md
/report/results_bge_large.md
/report/results_gemma.md
/report/results_openai.md
/report/results_openai_v2.md

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json

# --- Cloud-sync scratch (Google Drive) ---
.tmp.driveupload/

# --- Ad-hoc log captures ---
*.log

# --- Personal / working documents (kept local, not for the public repo) ---
code_understanding.md
old_readme.md
rag_comparison_project_datasets_and_references.md
